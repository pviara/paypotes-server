{
    "name": "paypotes-server",
    "version": "1.2.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "rm -rf dist; nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "setup:docker": "docker compose -f ./docker/docker-compose.yml down; docker compose -f ./docker/docker-compose.yml up -d",
        "setup:docker:e2e": "docker compose -f ./docker/docker-compose.test.yml down; docker compose -f ./docker/docker-compose.test.yml up -d",
        "start": "yarn setup:docker; sleep 4; nest start",
        "start:dev": "rm -rf dist; nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --maxWorkers=50%",
        "test:watch": "yarn test --watch",
        "test:all": "yarn test; yarn test:e2e",
        "test:e2e": "yarn build; jest --config ./test/jest-e2e.json --runInBand",
        "test:e2e:watch": "yarn test:e2e --watchAll",
        "update:deps": "yarn add -D npm-check-updates yarn-audit-fix; npx npm-check-updates --target minor --upgrade; yarn install; npx yarn-audit-fix; yarn remove npm-check-updates yarn-audit-fix"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.19",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.19",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.19",
        "amqplib": "^0.10.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "google-auth-library": "^10.6.2",
        "knex": "^3.2.9",
        "nestjs-knex": "^3.0.0",
        "passport": "^0.7.0",
        "passport-google-oauth2": "^0.2.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@nestjs/cli": "^11.0.21",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.19",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.15.30",
        "@types/amqplib": "^0.10.8",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.6.0",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth2": "^0.1.10",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.5.0",
        "jest": "^30.3.0",
        "jest-junit": "^16.0.0",
        "prettier": "^3.8.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-loader": "^9.5.7",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "moduleNameMapper": {
            "@app/(.*)": "<rootDir>/src/$1",
            "@auth/(.*)": "<rootDir>/src/auth/$1",
            "@contacts/(.*)": "<rootDir>/src/contacts/$1",
            "@expenses/(.*)": "<rootDir>/src/expenses/$1",
            "@groups/(.*)": "<rootDir>/src/groups/$1",
            "@infra/(.*)": "<rootDir>/src/infrastructure/$1",
            "@test/(.*)": "<rootDir>/test/$1",
            "@users/(.*)": "<rootDir>/src/users/$1"
        },
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest"
            ]
        },
        "setupFilesAfterEnv": [
            "<rootDir>/test/jest-global-setup.ts"
        ],
        "collectCoverage": false,
        "testEnvironment": "node",
        "reporters": [
            "default",
            [
                "jest-junit",
                {
                    "outputDirectory": "test/reports",
                    "outputName": "report-unit.xml"
                }
            ]
        ]
    }
}
