{
    "name": "paypot-server",
    "version": "1.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "rm -rf dist; nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "setup:docker": "docker compose -f ./docker-compose.yml down; docker compose -f ./docker-compose.yml up -d",
        "setup:docker:e2e": "docker compose -f ./docker-compose.test.yml down; docker compose -f ./docker-compose.test.yml up -d",
        "start": "yarn setup:docker; sleep 3; nest start",
        "start:dev": "rm -rf dist; nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --maxWorkers=50%",
        "test:ci": "jest --runInBand",
        "test:watch": "yarn test --watch",
        "test:all": "yarn test; yarn test:e2e",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "yarn build; APP_ENVIRONMENT=test CONTACT_TASKS_QUEUE=test_contact_tasks jest --config ./test/jest-e2e.json --runInBand",
        "test:e2e:ci": "yarn build; APP_ENVIRONMENT=test CONTACT_TASKS_QUEUE=test_contact_tasks jest --config ./test/jest-e2e.json --runInBand",
        "test:e2e:watch": "yarn test:e2e --watchAll"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.6",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.6",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.6",
        "amqplib": "^0.10.9",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "google-auth-library": "^10.3.0",
        "knex": "^3.1.0",
        "nestjs-knex": "^3.0.0",
        "passport": "^0.7.0",
        "passport-google-oauth2": "^0.2.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.34.0",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.7",
        "@nestjs/testing": "^11.1.6",
        "@swc/cli": "^0.7.8",
        "@swc/core": "^1.13.5",
        "@types/amqplib": "^0.10.7",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.3.0",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth2": "^0.1.10",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "jest": "^30.1.3",
        "jest-junit": "^16.0.0",
        "npm-check-updates": "^18.0.3",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.42.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "moduleNameMapper": {
            "@app/(.*)": "<rootDir>/src/$1",
            "@auth/(.*)": "<rootDir>/src/auth/$1",
            "@contacts/(.*)": "<rootDir>/src/contacts/$1",
            "@expenses/(.*)": "<rootDir>/src/expenses/$1",
            "@groups/(.*)": "<rootDir>/src/groups/$1",
            "@infra/(.*)": "<rootDir>/src/infrastructure/$1",
            "@test/(.*)": "<rootDir>/test/$1",
            "@users/(.*)": "<rootDir>/src/users/$1"
        },
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest"
            ]
        },
        "collectCoverage": false,
        "testEnvironment": "node",
        "reporters": [
            "default",
            [
                "jest-junit",
                {
                    "outputDirectory": "test/reports",
                    "outputName": "report-unit.xml"
                }
            ]
        ]
    }
}
