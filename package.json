{
    "name": "paypot-server",
    "version": "0.8.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "setup:docker": "docker compose down; docker compose -f ./docker-compose.yml up -d",
        "setup:docker:e2e": "docker compose down; docker compose -f ./docker-compose.test.yml up -d",
        "start": "yarn setup:docker; sleep 5; nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --maxWorkers=50%",
        "test:ci": "jest --runInBand",
        "test:watch": "yarn test --watch",
        "test:all": "yarn test; yarn test:e2e",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "APP_ENVIRONMENT=test CONTACT_TASKS_QUEUE=test_contact_tasks jest --config ./test/jest-e2e.json",
        "test:e2e:ci": "APP_ENVIRONMENT=test CONTACT_TASKS_QUEUE=test_contact_tasks jest --config ./test/jest-e2e.json --runInBand",
        "test:e2e:watch": "yarn test:e2e --watchAll"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/cqrs": "^11.0.1",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "amqplib": "^0.10.7",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "passport": "^0.7.0",
        "passport-google-oauth2": "^0.2.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/amqplib": "^0.10.7",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth2": "^0.1.10",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "moduleNameMapper": {
            "@app/(.*)": "<rootDir>/src/$1",
            "@auth/(.*)": "<rootDir>/src/auth/$1",
            "@contacts/(.*)": "<rootDir>/src/contacts/$1",
            "@expenses/(.*)": "<rootDir>/src/expenses/$1",
            "@groups/(.*)": "<rootDir>/src/groups/$1",
            "@infra/(.*)": "<rootDir>/src/infrastructure/$1",
            "@test/(.*)": "<rootDir>/test/$1",
            "@users/(.*)": "<rootDir>/src/users/$1"
        },
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "isolatedModules": true
                }
            ]
        },
        "collectCoverage": false,
        "testEnvironment": "node"
    }
}
