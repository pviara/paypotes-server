{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "../src",
    "testEnvironment": "node",
    "testRegex": ".e2e-spec.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
        "@app/(.*)": "<rootDir>/../src/$1",
        "@auth/(.*)": "<rootDir>/../src/auth/$1",
        "@groups/(.*)": "<rootDir>/../src/groups/$1",
        "@test/(.*)": "<rootDir>/../test/$1",
        "@users/(.*)": "<rootDir>/../src/users/$1"
    }
}
